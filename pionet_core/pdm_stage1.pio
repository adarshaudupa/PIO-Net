; ==============================================================================
; PIO-Net Stage-1 Temporal Persistence Speech Onset Filter (RP2040 PIO1)
;
; Solves the clap false alarm problem while maintaining 100% speech sensitivity:
; 1. Evaluates 32-bit PDM windows (31.25 us) against threshold (>= 19 ones).
; 2. Requires 4 CONSECUTIVE windows (128 us) of speech acoustic energy to wake CPU.
; 3. If any window falls below threshold, the persistence counter resets immediately.
;
; Result: Single-spike claps, clicks, and ambient noise decay too quickly and are
; dropped in hardware. Real speech easily sustains 128 us and wakes Core 0 cleanly.
; ==============================================================================

.program pdm_stage1

.wrap_target
reset:
    set x, 3            ; Require 4 consecutive active windows
    mov isr, x

new_window:
    set x, 18           ; Threshold: 19 ones out of 32
    set y, 31           ; 32-bit window

sample_bit:
    wait 0 gpio 10
    wait 1 gpio 10 [4]
    jmp pin bit_is_high
    jmp y-- sample_bit
    jmp reset           ; Window failed to reach threshold -> reset persistence counter

bit_is_high:
    jmp x-- check_window
    ; 19 ones reached in this window!
    mov x, isr          ; Load consecutive window persistence count
    jmp x-- win_ok
    irq wait 0          ; 4 consecutive windows reached! Wake CPU!
    jmp reset

win_ok:
    mov isr, x          ; Save decremented persistence count
    jmp new_window      ; Verify next consecutive window

check_window:
    jmp y-- sample_bit
    jmp reset           ; Window expired without reaching 19 ones
.wrap

% c-sdk {
static inline void pdm_stage1_program_init(PIO pio, uint sm, uint offset, uint clk_pin, uint data_pin) {
    pio_sm_config c = pdm_stage1_program_get_default_config(offset);

    sm_config_set_jmp_pin(&c, data_pin);

    // Enable hardware input buffers on both pads so PIO1 sees clock and data
    gpio_set_input_enabled(clk_pin, true);
    gpio_set_input_enabled(data_pin, true);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}