; ==============================================================================
; PIO-Net Stage-1 gate (SM B): counts 1-bits in consecutive 32-clock windows
; straight from the PDM pins and raises PIO IRQ 0 when >= 22 of 32 bits are ones.
; Equivalent to popcount(~(word ^ 0xFFFFFFFF)) >= 22 for the all-ones pattern.
;
; No FIFO, no DMA, no CPU. Runs alongside pdm_reader (SM A) on the same PIO block.
;   CLK  = GPIO 10 (driven by SM A, read here via absolute `wait gpio`)
;   DATA = GPIO 11 (read via `jmp pin`, set with sm_config_set_jmp_pin)
;
; Sampling: DATA is read on the FALLING clock edge (mid-bit), when the value launched
; at the preceding rising edge is stable. Same bit stream as SM A, half a period apart.
;
; Threshold trick: y counts down from 21. Each 1-bit executes `jmp y--`, which branches
; while y != 0. The 22nd 1-bit finds y == 0, falls through and raises the IRQ.
; Per window: 32 clocks (x = 31..0). Windows are not aligned to SM A's 32-bit words.
;
; Budget: 9 instructions, ~5 cycles per bit vs ~122 available at 125 MHz / 1.024 MHz.
; ==============================================================================

.program pdm_stage1

; Hardware Stage-1 Acoustic Wake-Up Gate
; Runs on PIO1 while Core 0 CPU sleeps in __wfi()
; Samples GPIO 11 (PDM DATA) on the rising edge of GPIO 10 (PDM CLK)

.wrap_target
start:
    set x, 20              ; Threshold: 20 ones to trigger
    set y, 31              ; Window: 32 bit cycles

sample_bit:
    wait 0 gpio 10         ; Wait for PDM CLK low
    wait 1 gpio 10         ; Wait for PDM CLK rising edge
    jmp pin bit_is_high    ; Branch if PDM DATA (GPIO 11) is 1

bit_is_low:
    jmp y-- sample_bit     ; Decrement window counter Y
    jmp start              ; Window expired: reset

bit_is_high:
    jmp x-- check_window   ; Decrement threshold counter X
    irq wait 0             ; Threshold reached: fire PIO IRQ 0 and wait for CPU
    jmp start              ; Reset after CPU acknowledges

check_window:
    jmp y-- sample_bit     ; Decrement window counter Y
    jmp start              ; Window expired: reset
.wrap

% c-sdk {
static inline void pdm_stage1_program_init(PIO pio, uint sm, uint offset, uint clk_pin, uint data_pin) {
    pio_sm_config c = pdm_stage1_program_get_default_config(offset);

    sm_config_set_jmp_pin(&c, data_pin);

    // Enable hardware input buffers on both pads so PIO1 sees clock and data
    gpio_set_input_enabled(clk_pin, true);
    gpio_set_input_enabled(data_pin, true);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}