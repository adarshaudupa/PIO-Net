; ==============================================================================
; PIO-Net Stage-1: Two-Tier Temporal Duration-Energy Gate (RP2040 PIO1)
;
; Microarchitectural implementation within strict 32-instruction silicon limit:
;
; 1. Inner Tier (Block Energy):
;    Evaluates 32-bit PDM sub-blocks (31.25 us). Requires >= 19 ones out of 32
;    (59.4% acoustic speech density).
; 2. Outer Tier (Temporal Persistence):
;    Maintains a 12-block countdown loop in the ISR scratch register.
;    Requires 12 CONSECUTIVE qualifying sub-blocks to wake the CPU (~375 us).
; 3. Deterministic Reset:
;    If any sub-block fails (< 19 ones), the outer persistence counter is
;    immediately reset to 12. Short single-spike impulse transients decay
;    too quickly to satisfy 12 consecutive blocks and are dropped in hardware.
; 4. Hardware IRQ Wake:
;    When all 12 consecutive blocks qualify, asserts `irq wait 0` to wake Core 0.
; ==============================================================================

.program pdm_stage1

.wrap_target
reset:
    set x, 11           ; Outer counter: require 12 consecutive qualifying sub-blocks (375 us)
    mov isr, x

new_block:
    set x, 18           ; Inner counter: threshold >= 19 ones out of 32 bits (59.4% speech density)
    set y, 31           ; Inner window: 32 PDM clocks

sample_bit:
    wait 0 gpio 10      ; Wait for PDM CLK falling edge
    wait 1 gpio 10 [4]  ; Wait for PDM CLK rising edge + setup delay
    jmp pin bit_is_high ; Sample GPIO 11 (PDM DATA)
    jmp y-- sample_bit  ; Bit is 0: decrement window counter Y, continue sampling
    jmp reset           ; Y reached 0: window finished without 19 ones -> FAIL, reset outer counter

bit_is_high:
    jmp x-- check_window; Bit is 1: decrement ones counter X
    ; Threshold reached! 19 ones accumulated in this sub-block -> PASS!
    mov x, isr          ; Load outer persistence counter from ISR
    jmp x-- block_ok    ; Decrement outer persistence counter
    irq wait 0          ; All 12 consecutive blocks qualified! WAKE CPU!
    jmp reset

block_ok:
    mov isr, x          ; Save decremented outer persistence counter back to ISR
    jmp new_block       ; Verify next consecutive sub-block

check_window:
    jmp y-- sample_bit  ; Continue sampling remaining bits in window
    jmp reset           ; Window finished without 19 ones -> FAIL, reset outer counter
.wrap

% c-sdk {
static inline void pdm_stage1_program_init(PIO pio, uint sm, uint offset, uint clk_pin, uint data_pin) {
    pio_sm_config c = pdm_stage1_program_get_default_config(offset);

    sm_config_set_jmp_pin(&c, data_pin);

    // Enable hardware input buffers on both pads so PIO1 sees clock and data
    gpio_set_input_enabled(clk_pin, true);
    gpio_set_input_enabled(data_pin, true);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}